{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomCode": {
        ".read": "$roomCode.matches(/^[A-Z0-9_-]{4,12}$/)",
        ".write": "$roomCode.matches(/^[A-Z0-9_-]{4,12}$/)",
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
        },
        "activeNoteId": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)"
        },
        "notes": {
          ".validate": "!newData.exists() || newData.hasChildren()"
        },
        "elements": {
          ".validate": "!newData.exists() || newData.hasChildren()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "presence": {
      "$roomCode": {
        ".read": "$roomCode.matches(/^[A-Z0-9_-]{4,12}$/)",
        "$connId": {
          ".write": "$roomCode.matches(/^[A-Z0-9_-]{4,12}$/)",
          ".validate": "!newData.exists() || (newData.hasChild('at') && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000)",
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}